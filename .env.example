# =========================================================
# ShipTrack – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =========================================================

# ---- PostgreSQL ----
POSTGRES_USER=shiptrack
POSTGRES_PASSWORD=shiptrack_dev_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Identity Service ----
IDENTITY_DB=identity_db
# JWT: symmetric key, minimum 32 characters. Change in production!
JWT_SECRET=your-super-secret-jwt-signing-key-at-least-32-chars
JWT_ISSUER=ShipTrack
JWT_AUDIENCE=ShipTrackClient
JWT_EXPIRY_MINUTES=15
# Admin seeded on startup (never hard-code in source)
ADMIN_EMAIL=admin@shiptrack.dev
ADMIN_PASSWORD=Admin@123456
# Rate limiter: 5 login attempts per minute per IP
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# ---- Inventory Service ----
INVENTORY_DB=inventory_db
# Secret header value for internal service-to-service calls (not exposed via Gateway)
INVENTORY_INTERNAL_KEY=internal-service-key-change-in-production

# ---- Orders Service ----
ORDERS_DB=orders_db
# URL the Orders service uses to call Inventory (internal Docker network)
INVENTORY_INTERNAL_URL=http://inventory:8080
INVENTORY_INTERNAL_URL_EXTERNAL=http://localhost:5002

# ---- Gateway ----
# URLs the Gateway proxies to (internal Docker network)
IDENTITY_INTERNAL_URL=http://identity:8080
INVENTORY_INTERNAL_URL_GATEWAY=http://inventory:8080
ORDERS_INTERNAL_URL=http://orders:8080

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000
